{
  "productName": "Eleve",
  "mainBinaryName": "eleve-chat-desktop",
  "version": "0.1.0",
  "identifier": "com.eleve.chat.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:24243",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eleve",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "devtools": true,
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; frame-src http: https: tauri:; connect-src ipc: http://ipc.localhost tauri: http://tauri.localhost http://127.0.0.1:* ws://127.0.0.1:*; script-src 'unsafe-inline' 'self' 'wasm-unsafe-eval'; style-src 'unsafe-inline' 'self' 'unsafe-eval'; img-src 'self' data: blob: tauri: http: https:; font-src 'self' data:",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Eleve",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/agent-browser-win32-x64.exe",
      "binaries/eleved.exe",
      "binaries/rg.exe",
      "binaries/tirith.exe",
      "binaries/cua-driver.exe",
      "binaries/cua-driver-uia.exe",
      "binaries/cua-cursor-theme.exe",
      "binaries/cua-driver-LICENSE.txt",
      "resources/wakewords/hey_eleve.onnx",
      "resources/wakewords/sherpa/encoder-epoch-12-avg-2-chunk-16-left-64.onnx",
      "resources/wakewords/sherpa/decoder-epoch-12-avg-2-chunk-16-left-64.onnx",
      "resources/wakewords/sherpa/joiner-epoch-12-avg-2-chunk-16-left-64.onnx",
      "resources/wakewords/sherpa/tokens.txt",
      "plugins/canvas"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "nsis-uninstall-hook.nsh"
      }
    }
  }
}