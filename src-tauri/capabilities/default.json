{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "kanban"
  ],
  "webviews": [
    "main",
    "kanban"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-is-visible",
    "core:window:allow-is-minimized",
    "core:window:allow-set-min-size",
    "core:window:allow-start-dragging",
    "core:window:allow-create",
    "core:window:allow-set-focus",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-inner-size",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-title",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-create-webview",
    "core:webview:allow-webview-hide",
    "core:webview:allow-webview-show",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-focus",
    "core:webview:allow-webview-close",
    "dialog:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "allow-get-gateway-port",
    "allow-get-auto-start",
    "allow-set-auto-start",
    "allow-create-deepseek-webview",
    "allow-toggle-kanban-window",
    "allow-open-canvas-window",
    "allow-toggle-canvas-window",
    "allow-close-canvas-window",
    "allow-open-image-editor-window",
    "allow-editor-result-set",
    "allow-editor-result-get",
    "allow-mark-restarting",
    "allow-preview-console-push",
    "allow-preview-console-snapshot",
    "allow-preview-webview-create",
    "allow-preview-webview-close",
    "allow-preview-webview-update",
    "allow-preview-webview-navigate",
    "allow-preview-webview-reload",
    "allow-preview-webview-visible",
    "allow-preview-webview-devtools",
    "allow-preview-file-watch",
    "allow-preview-file-unwatch",
    "allow-pty-start",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-dispose",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    }
  ]
}